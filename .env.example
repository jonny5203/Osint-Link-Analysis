# Copy this file to .env and fill in real values before `docker compose up`.

# Neo4j — pick a real password for local dev.
NEO4J_PASSWORD=replace-with-a-strong-password
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=replace-with-another-strong-password

# OpenCorporates enrichment. Leave blank to skip enrichment.
OPEN_CORPORATES_API_TOKEN=
